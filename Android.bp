package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "bert_collector_defaults",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-argument",
        "-Wno-unused-function",
        "-Wno-nullability-completeness",
        "-Os",
    ],
    shared_libs: [
        "libbase",
        "libbrillo",
        "liblog",
        "libservices",
        "libutils",
    ],
}

cc_binary {
    name: "bert_collector",
    defaults: [
        "bert_collector_defaults",
    ],
    srcs: [
        "main.cpp",
        "bert_collector.cpp",
    ],
}

cc_test {
    name: "bert_collector_test",
    defaults: [
        "bert_collector_defaults",
    ],
    srcs: [
        "bert_collector_test.cpp",
    ],
    test_suites: ["general-tests"],
}
